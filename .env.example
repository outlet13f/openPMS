# compose.yaml settings. Copy to .env (git-ignored) on the server and fill in; never commit values.

# Public address users open, behind the reverse proxy (links in e-mails, SSO callback address), e.g. https://pms.example.co.kr
OPENPMS_BASE_URL=

# Database password for the bundled PostgreSQL (long and random, e.g. openssl rand -base64 32)
OPENPMS_DB_PASSWORD=

# Company SMTP relay
OPENPMS_SMTP_HOST=
OPENPMS_SMTP_PORT=25
OPENPMS_SMTP_USER=
OPENPMS_SMTP_PASSWORD=
OPENPMS_SMTP_STARTTLS=false
OPENPMS_MAIL_FROM=

# CI/CD 연동 토큰·웹훅 비밀 암호화 키(32바이트 Base64, openssl rand -base64 32). 잃으면 연동 토큰을 다시 넣어야 함
OPENPMS_SECRET_KEY=

# First administrator: with no admin yet, startup invites this address and logs a one-time setup link
OPENPMS_ADMIN_EMAIL=

# Optional
# host port the app listens on (127.0.0.1 only)
OPENPMS_PORT=8090
OPENPMS_SESSION_TIMEOUT=8h
# true unless the proxy serves plain http (testing only)
OPENPMS_SECURE_COOKIES=true
# The client address (sign-in limits) and https come from the proxy's X-Forwarded-For / X-Forwarded-Proto headers, trusted
# only from these addresses (a regular expression; default: this host, Docker's 172.16-31.x and Podman's 10.88-89.x networks). The proxy must set
# both headers, e.g. nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme;
# OPENPMS_TRUSTED_PROXIES=
# none: ignore the headers (the app is reached directly, without a proxy)
# OPENPMS_FORWARD_HEADERS=native
# true: date alerts, notification mail and cleanup run in this instance
OPENPMS_JOBS_ENABLED=true
# true: webhooks may not be sent to loopback or private-network addresses (10.x, 172.16-31.x, 192.168.x, ...).
# Link-local addresses (169.254.x, cloud metadata) are always refused.
# OPENPMS_WEBHOOK_BLOCK_PRIVATE=false
# CI/CD webhooks accepted per sending address and minute (raise it if a big push makes GitLab/GitHub report 429)
# OPENPMS_CICD_HOOK_REQUESTS_PER_MINUTE=600
# Before an upgrade applies database migrations the app writes a pg_dump into /data/backups (the "backups" volume) and
# stops if that fails. false: skip it (only when you have a backup of your own). KEEP: dumps of each kind kept (default 5).
# OPENPMS_BACKUP_BEFORE_UPGRADE=true
# OPENPMS_BACKUP_KEEP=5
