# openPMS environment variables. Copy to .env (git-ignored) on the server and fill in; never commit values.
# Development: scripts/dev.sh creates backend/.env.local with a generated database password and sets the rest.

# Public address users open (links in e-mails)
OPENPMS_BASE_URL=

# PostgreSQL 17
OPENPMS_DB_URL=
OPENPMS_DB_USER=
OPENPMS_DB_PASSWORD=

# Company SMTP relay
OPENPMS_SMTP_HOST=
OPENPMS_SMTP_PORT=
OPENPMS_SMTP_USER=
OPENPMS_SMTP_PASSWORD=
OPENPMS_SMTP_STARTTLS=
OPENPMS_MAIL_FROM=

# First administrator: with no admin yet, startup invites this address and logs a one-time setup link
OPENPMS_ADMIN_EMAIL=

# Optional
OPENPMS_SESSION_TIMEOUT=
OPENPMS_SECURE_COOKIES=
OPENPMS_FILES_DIR=
# true (default): date alerts, notification mail and cleanup run in this instance. false: web only
OPENPMS_JOBS_ENABLED=
