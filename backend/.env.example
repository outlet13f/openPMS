# openPMS environment variables. Copy to .env (git-ignored) on the server and fill in; never commit values.
# Development: scripts/dev.sh creates backend/.env.local with a generated database password and sets the rest.

# Public address users open (links in e-mails)
OPENPMS_BASE_URL=

# PostgreSQL 17
OPENPMS_DB_URL=
OPENPMS_DB_USER=
OPENPMS_DB_PASSWORD=

# Company SMTP relay
OPENPMS_SMTP_HOST=
OPENPMS_SMTP_PORT=
OPENPMS_SMTP_USER=
OPENPMS_SMTP_PASSWORD=
OPENPMS_SMTP_STARTTLS=
OPENPMS_MAIL_FROM=

# First administrator: with no admin yet, startup invites this address and logs a one-time setup link
OPENPMS_ADMIN_EMAIL=

# Optional
OPENPMS_SESSION_TIMEOUT=
OPENPMS_SECURE_COOKIES=
OPENPMS_FILES_DIR=
# true (default): date alerts, notification mail and cleanup run in this instance. false: web only
OPENPMS_JOBS_ENABLED=
# true: webhooks may not go to loopback or private-network addresses (link-local is always refused)
# OPENPMS_WEBHOOK_BLOCK_PRIVATE=false
# true (default): pg_dump into OPENPMS_BACKUP_DIR (default /data/backups) before an upgrade applies migrations; a failed dump stops the start-up
# OPENPMS_BACKUP_BEFORE_UPGRADE=
# OPENPMS_BACKUP_DIR=
# OPENPMS_BACKUP_KEEP=
# Behind a reverse proxy: client address and https from X-Forwarded-For / X-Forwarded-Proto, trusted only from these
# addresses (regular expression; default this host, Docker's 172.16-31.x and Podman's 10.88-89.x; leave unset for the default). none: ignore the headers
# OPENPMS_TRUSTED_PROXIES=
# OPENPMS_FORWARD_HEADERS=
