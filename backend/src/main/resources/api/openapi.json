{
  "openapi": "3.1.0",
  "info": {
    "title": "openPMS API",
    "version": "1",
    "description": "사내 연동용 API. 모든 경로는 /api/v1 아래에 있습니다. 계정 설정 · API 토큰에서 만든 토큰을 `Authorization: Bearer opms_…` 헤더로 보냅니다. 토큰은 만든 사람의 권한으로 동작하고, 읽기 전용 토큰은 조회(GET과 목록 조회·내보내기)만 할 수 있습니다. 토큰마다 분당 300회까지입니다. v1 안에서는 필드를 더하기만 하고 빼거나 뜻을 바꾸지 않습니다. 그런 변경은 /api/v2로 냅니다. 오류는 RFC 9457 problem+json(title, detail, errors[{field, message}])입니다. 무언가를 만드는 POST(작업·코멘트·복사 등)에는 `Idempotency-Key: <요청마다 새 임의 값>` 헤더를 붙이세요. 같은 키로 다시 보내면 처음 응답을 그대로 돌려주고(`Idempotent-Replayed: true`, 하루 보관) 두 번 만들지 않습니다. 같은 키를 다른 본문에 쓰면 422, 처음 요청을 처리 중이면 409입니다."
  },
  "servers": [{ "url": "/api/v1" }],
  "security": [{ "token": [] }],
  "components": {
    "securitySchemes": {
      "token": { "type": "http", "scheme": "bearer", "bearerFormat": "opms_<token>", "description": "계정 설정 · API 토큰에서 발급" }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "title": { "type": "string" },
          "detail": { "type": ["string", "null"] },
          "errors": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "message": { "type": "string" } } } }
        }
      },
      "Ref": { "type": "object", "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } } },
      "WorkPackage": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "number": { "type": "integer", "description": "화면의 #번호" },
          "subject": { "type": "string" },
          "descriptionHtml": { "type": "string" },
          "project": { "type": "object", "properties": { "id": { "type": "string" }, "identifier": { "type": "string" }, "name": { "type": "string" } } },
          "type": { "$ref": "#/components/schemas/Ref" },
          "status": { "$ref": "#/components/schemas/Ref" },
          "priority": { "$ref": "#/components/schemas/Ref" },
          "assignee": { "oneOf": [{ "$ref": "#/components/schemas/Ref" }, { "type": "null" }] },
          "startDate": { "type": ["string", "null"], "format": "date" },
          "dueDate": { "type": ["string", "null"], "format": "date" },
          "doneRatio": { "type": ["integer", "null"] },
          "lockVersion": { "type": "integer", "description": "수정할 때 그대로 보냅니다(다른 사람이 먼저 고쳤으면 409)" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "QuerySpec": {
        "type": "object",
        "description": "목록 보기와 같은 조건. 예: {\"v\":1,\"filters\":[{\"field\":\"status\",\"op\":\"open\"}],\"columns\":[\"subject\"],\"sort\":[{\"field\":\"number\",\"dir\":\"asc\"}],\"groupBy\":null,\"hierarchy\":false,\"sums\":false,\"includeSubprojects\":false}",
        "properties": {
          "v": { "const": 1 },
          "filters": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "op": { "type": "string" }, "values": { "type": "array", "items": { "type": "string" } } } } },
          "sort": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "dir": { "enum": ["asc", "desc"] } } } },
          "text": { "type": ["string", "null"] }
        }
      }
    },
    "responses": {
      "Problem": { "description": "오류", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
    }
  },
  "paths": {
    "/auth/me": {
      "get": { "summary": "토큰 주인", "responses": { "200": { "description": "사용자" }, "401": { "$ref": "#/components/responses/Problem" } } }
    },
    "/projects": {
      "get": {
        "summary": "볼 수 있는 프로젝트",
        "parameters": [
          { "name": "filter", "in": "query", "schema": { "enum": ["active", "mine", "favorite", "archived", "templates"] } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "maximum": 100 } }
        ],
        "responses": { "200": { "description": "{items, total, page, pageSize}" } }
      }
    },
    "/projects/{project}": {
      "get": { "summary": "프로젝트(식별자나 id)", "parameters": [{ "name": "project", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "프로젝트" }, "404": { "$ref": "#/components/responses/Problem" } } }
    },
    "/work-packages/query": {
      "post": {
        "summary": "작업 목록 조회(읽기 전용 토큰도 가능)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "projectId": { "type": "string" }, "page": { "type": "integer" }, "pageSize": { "type": "integer", "maximum": 200 }, "spec": { "$ref": "#/components/schemas/QuerySpec" } } } } } },
        "responses": { "200": { "description": "{rows: [{wp, depth, …}], total, page, pageSize}" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/projects/{project}/work-packages": {
      "post": {
        "summary": "작업 만들기",
        "parameters": [{ "name": "project", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["subject", "typeId"], "properties": { "subject": { "type": "string" }, "typeId": { "type": "string" }, "statusId": { "type": "string" }, "assigneeId": { "type": "string" }, "startDate": { "type": "string", "format": "date" }, "dueDate": { "type": "string", "format": "date" }, "descriptionHtml": { "type": "string" }, "parentNumber": { "type": "integer" } } } } } },
        "responses": { "201": { "description": "만든 작업", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkPackage" } } } }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/work-packages/{number}": {
      "get": { "summary": "작업 하나", "parameters": [{ "name": "number", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "작업", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkPackage" } } } }, "404": { "$ref": "#/components/responses/Problem" } } },
      "patch": {
        "summary": "작업 고치기(lockVersion 필수)",
        "parameters": [{ "name": "number", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["lockVersion"], "properties": { "lockVersion": { "type": "integer" }, "subject": { "type": "string" }, "statusId": { "type": "string" }, "assigneeId": { "type": ["string", "null"] }, "priorityId": { "type": "string" }, "startDate": { "type": ["string", "null"] }, "dueDate": { "type": ["string", "null"] }, "doneRatio": { "type": ["integer", "null"] } } } } } },
        "responses": { "200": { "description": "고친 작업" }, "409": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/work-packages/{number}/activities": {
      "get": { "summary": "활동(변경과 코멘트)", "parameters": [{ "name": "number", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "활동 목록" } } }
    },
    "/work-packages/{number}/comments": {
      "post": {
        "summary": "코멘트 남기기",
        "parameters": [{ "name": "number", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["bodyHtml"], "properties": { "bodyHtml": { "type": "string" }, "internal": { "type": "boolean" } } } } } },
        "responses": { "201": { "description": "남긴 코멘트" } }
      }
    },
    "/work-packages/filters": {
      "get": { "summary": "필터에 쓰는 값(상태·유형·우선순위·사람·버전 등의 id)", "parameters": [{ "name": "projectId", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "값 목록" } } }
    },
    "/work-packages/export": {
      "post": { "summary": "CSV·Excel·PDF로 내보내기(읽기 전용 토큰도 가능)", "responses": { "200": { "description": "파일" } } }
    },
    "/time-entries": {
      "get": { "summary": "시간 기록 목록: workPackage(번호) 하나의 전체, 또는 from·to(최대 1년)·project·user(me|id). 내 것은 time.log, 다른 사람 것은 time.view가 있을 때만", "responses": { "200": { "description": "[{ id, user, project, workPackage, activity, spentOn, hours, comment, canEdit }]" } } },
      "post": { "summary": "시간 기록: { workPackageNumber, spentOn, hours(0 초과 24 이하, 소수 둘째 자리), activityId?, comment?, userId?(time.manage) }. 한 사람의 하루는 24시간까지. Idempotency-Key 권장", "responses": { "201": { "description": "기록" }, "403": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } } }
    },
    "/time-entries/week": {
      "get": { "summary": "내 한 주(start가 속한 주): 날짜·휴무일, 하루 근무 시간, 작업별 칸(시간·건수)", "responses": { "200": { "description": "{ start, days, hoursPerDay, rows }" } } },
      "put": { "summary": "내 한 주 저장: { start, cells: [{ workPackageNumber, date, hours }] } — 칸마다 그날 내 시간을 그 값으로(0은 지움). 여러 건으로 기록된 칸은 바꿀 수 없음. 전부 되거나 전부 안 됨(422에 칸 목록)", "responses": { "200": { "description": "저장 뒤의 주" }, "422": { "$ref": "#/components/responses/Problem" } } }
    },
    "/time-entries/report": {
      "get": { "summary": "공수 합계: from·to·project·user, groupBy = user | workPackage | activity | project | day. 볼 수 있는 기록만", "responses": { "200": { "description": "{ from, to, groupBy, rows: [{ key, label, hours }], total }" } } }
    },
    "/work-packages/export/count": {
      "post": { "summary": "내보내기 전 건수: total 목록에 맞는 작업, count 파일에 들어갈 작업(내보내기 권한), excluded 권한이 없어 빠지는 작업, limit 최대 건수(total이 넘으면 count·excluded 0). 본문은 내보내기와 같음(읽기 전용 토큰도 가능)", "responses": { "200": { "description": "{ total, count, excluded, limit }" }, "403": { "$ref": "#/components/responses/Problem" } } }
    }
  }
}
